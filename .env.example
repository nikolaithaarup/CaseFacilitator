# Required outside Firebase emulator mode
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_PROJECT_ID=demo-synapse-facilitator

# Production access control
# Keep false in Vercel Production. Set true only for deliberate local/demo standalone use.
EXPO_PUBLIC_FACILITATOR_ALLOW_STANDALONE=false
EXPO_PUBLIC_SYNAPSE_PORTAL_URL=https://portal.synapsestudio.dk
EXPO_PUBLIC_FACILITATOR_LAUNCH_AUDIENCE=synapse-facilitator-v1

# Added later when the trusted server-side Portal bridge is deployed.
EXPO_PUBLIC_FACILITATOR_BACKEND_BASE_URL=
